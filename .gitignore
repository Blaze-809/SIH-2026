# ─────────────────────────────────────────────────────────────────────────
#  SIH-2026 · SIH26149
#  Integrated Secure Data Erasure & Advanced File Recovery Tool
# ─────────────────────────────────────────────────────────────────────────


# =========================================================================
#  1. FORENSIC ARTIFACTS — NEVER COMMIT
#     Disk images are hundreds of MB (GitHub hard-rejects >100 MB), and
#     recovered/carved output may contain real personal data. Treat this
#     section as a safety net, not permission to be careless.
# =========================================================================

# Raw and forensic disk images
*.img
*.dd
*.raw
*.iso
*.dmg
*.E01
*.Ex01
*.L01
*.aff
*.aff4
*.s01
*.vmdk
*.vhd
*.vhdx
*.qcow2

# Split image segments (image.001, image.002, …)
*.[0-9][0-9][0-9]

# Working directories for evidence and output
evidence/
cases/
disk-images/
carved-output/
recovered/
dumps/
sanitization-runs/
*.casefile

# Memory / hex dumps
*.mem
*.dump
*.hexdump


# =========================================================================
#  2. KEYS, CERTIFICATES AND SECRETS
#     The signing key for our certificates must never reach the repo.
#     Commit the PUBLIC key only.
# =========================================================================
*.pem
*.key
*.pfx
*.p12
*.jks
!*public*.pem
!*.pub

.env
.env.*
!.env.example
secrets.toml
config.local.*
**/credentials.json


# =========================================================================
#  3. RUST  (core engine)
#     Note: Cargo.lock IS committed — this workspace produces binaries,
#     so a locked dependency set is what we want. Do not add it here.
# =========================================================================
/target/
**/target/
**/*.rs.bk
*.pdb


# =========================================================================
#  4. PYTHON  (carving research, ML, tooling)
# =========================================================================
__pycache__/
*.py[cod]
*$py.class
*.so

.venv/
venv/
env/
ENV/

build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
MANIFEST

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/

.ipynb_checkpoints/


# =========================================================================
#  5. NODE / TAURI / FRONTEND
# =========================================================================
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

dist/
dist-ssr/
.vite/
*.local

# Tauri build output (source stays tracked)
src-tauri/target/
src-tauri/gen/
src-tauri/WixTools/


# =========================================================================
#  6. ML MODELS AND DATASETS
#     Track training code and configs; publish weights as GitHub Releases
#     or via Git LFS rather than committing them.
# =========================================================================
*.pt
*.pth
*.onnx
*.pkl
*.joblib
*.h5
*.ckpt
*.safetensors

datasets/
corpora/
training-data/
runs/
wandb/
mlruns/


# =========================================================================
#  7. DATABASES AND LOGS
#     Case stores hold evidence metadata and audit chains — keep local.
# =========================================================================
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
!schema.sql

*.log
logs/
audit-log-*.jsonl


# =========================================================================
#  8. BUILD, PACKAGING AND ISO OUTPUT
# =========================================================================
/build/
/out/
/release/
*.deb
*.rpm
*.msi
*.exe
*.AppImage
iso/work/
iso/out/
*.squashfs


# =========================================================================
#  9. EDITORS AND OS
# =========================================================================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/


# =========================================================================
# 10. OFFICE LOCK FILES
#     The SIH deck lives in docs/ — these appear while it is open and
#     must not be committed.
# =========================================================================
~$*.pptx
~$*.docx
~$*.xlsx
.~lock.*#


# =========================================================================
# 11. EXPLICIT EXCEPTIONS
#     Small, synthetic test fixtures are safe and useful to track.
#     Anything here must be generated by us — never real evidence.
# =========================================================================
!tests/fixtures/
!tests/fixtures/**
!tests/fixtures/*.img
!docs/**
!img/**
